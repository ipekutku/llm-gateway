          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(gateway_request_duration_seconds_bucket[$__range])))",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Estimated cost",
      "description": "Estimated cost from the pricing file over the time range; a float estimate. PostgreSQL usage records hold the exact values.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
