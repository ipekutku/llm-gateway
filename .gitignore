# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Local environment files; sanitized examples/templates remain trackable.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template

# Local gateway clients file. Public synthetic fixtures under deploy/ stay tracked.
/clients.json

# Credential directories accidentally copied into the repository root.
/.aws/
/.docker/
/.kube/

# Profiling captures may contain sensitive process information.
*.prof
*.pprof

# macOS Finder metadata
.DS_Store

# Local load-test reports, profiles, logs, and binaries
/deploy/loadtest/results/
/deploy/kind/results/

# Terraform working data, state, plans, and local account/backend configuration.
# Provider lock files and *.example templates are intentionally committed.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
*.tfbackend
crash.log
crash.*.log
/deploy/aws/bootstrap/backend.tf
# Client keys make aws-deploy generates for a session's checks.
/deploy/aws/session/

# Editor/IDE
# .idea/
# .vscode/
